# Create a bot with @BotFather and put its token here.
BOT_TOKEN=

# Your numeric Telegram user ID (not your username).
OWNER_ID=

# Required only for the Local Bot API Server (large-file mode).
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# docker-compose.yml configures these automatically for local mode.
BOT_API_MODE=local
BOT_API_BASE_URL=http://127.0.0.1:8081/bot
BOT_API_FILE_URL=http://127.0.0.1:8081/file/bot

FILES_DIR=files
